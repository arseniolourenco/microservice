{
  "id": "spring-boot-microservices-realm",
  "realm": "spring-boot-microservices-realm",
  "enabled": true,
  "displayName": "Java Spring Boot Microservices",
  "sslRequired": "NONE",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Administrator with full access" },
      { "name": "USER", "description": "Normal user role" }
    ]
  },

  "groups": [
    {
      "name": "developers",
      "realmRoles": ["USER"]
    }
  ],

  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Arsénio",
      "lastName": "Lourenço",
      "email": "seniomauro@gmail.com",
      "credentials": [
        { "type": "password", "value": "admin", "temporary": false }
      ],
      "realmRoles": ["ADMIN"],
      "groups": ["developers"]
    }
  ],

  "clients": [
    {
      "clientId": "spring-cloud-client",
      "name": "spring-cloud-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "secret": "gateway-secret",

      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],

      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    }
  ],

  "clientScopes": [
    {
      "name": "roles",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ]
}